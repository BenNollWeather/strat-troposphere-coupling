# Public defaults. Environment variables already set take precedence.
# This file has no credentials, profiles, or machine paths.

WORK_DIR="${WORK_DIR:-/tmp/strat-coupling}"
PYTHON_CMD="${PYTHON_CMD:-python3}"
UPLOAD_TO_S3="${UPLOAD_TO_S3:-true}"
MODEL="${MODEL:-both}"
FORCE="${FORCE:-false}"

S3_PREFIX="${S3_PREFIX:-s3://bennollweather/climate_imagery/strat_coupling/}"
PUBLIC_URL="${PUBLIC_URL:-https://bennollweather.s3.amazonaws.com/climate_imagery/strat_coupling/}"
STATUS_S3_PREFIX="${STATUS_S3_PREFIX:-s3://bennollweather/climate_imagery/status}"

# Wait for the cycle that should just have finished. The wait only checks
# the open-data index. Field data is read later, into memory.
WAIT_MINUTES="${WAIT_MINUTES:-50}"
POLL_SECONDS="${POLL_SECONDS:-60}"
WORKERS="${WORKERS:-8}"
CLIM_WORKERS="${CLIM_WORKERS:-8}"
SOURCE="${SOURCE:-gcs}"
